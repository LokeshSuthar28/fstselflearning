# Backend API base URL (Next.js backend server — runs on port 3000)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# App Identity
NEXT_PUBLIC_APP_NAME="Step High Sneakers"
NEXT_PUBLIC_APP_VERSION="2.4.0"

# Optional: set a mock session role for local development
# Accepted values: ADMIN | MEMBER | GUEST
# NEXT_PUBLIC_MOCK_ROLE=MEMBER
